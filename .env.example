# Copy to .env and fill in the keys you have. Every key is optional:
# modules without a key are shown as "skipped" and everything else still works.

# https://www.abuseipdb.com/account/api  (free tier: 1,000 checks/day)
ABUSEIPDB_API_KEY=

# https://www.virustotal.com/gui/my-apikey  (free tier: 500 lookups/day)
VIRUSTOTAL_API_KEY=

# https://haveibeenpwned.com/API/Key  (paid)
HIBP_API_KEY=

# Optional tuning
# OSINT_MODULE_TIMEOUT=25
# OSINT_CACHE_TTL=600
# OSINT_RATE_LIMIT=20
